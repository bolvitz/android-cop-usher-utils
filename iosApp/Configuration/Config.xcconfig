PRODUCT_BUNDLE_IDENTIFIER = com.eventmonitor.app
PRODUCT_NAME = Event Monitor
DEVELOPMENT_LANGUAGE = en
IPHONEOS_DEPLOYMENT_TARGET = 17.0
SWIFT_VERSION = 5.0
TARGETED_DEVICE_FAMILY = 1,2
ENABLE_USER_SCRIPT_SANDBOXING = NO

// App Store versioning. Bump CURRENT_PROJECT_VERSION for every upload;
// bump MARKETING_VERSION for each user-facing release.
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1

// Signing: set your Apple Developer Team ID (Xcode > Settings > Accounts).
CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM =

ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
